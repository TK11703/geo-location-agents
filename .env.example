# Inputs for an erdc-agents azd environment. Everything here is safe to commit: none of it is a
# secret, and none of it names a resource. The template derives every resource name from the
# environment name, and writes the results back as outputs -- endpoints, the Foundry project, the
# gateway URL, the model deployments -- so those are never set by hand.
#
# Bootstrap a new environment from this file:
#   azd env new <name> --subscription <id> --location <region>
#   Get-Content .env.example | Where-Object { $_ -match '^\w+=' } | ForEach-Object {
#       $k, $v = $_ -split '=', 2; azd env set $k $v.Trim('"') }
#   azd up

# Resource group to create. Everything lands here. Defaults to rg-<environment name>.
AZURE_RESOURCE_GROUP="rg-erdc-agents-dev"

# The National Weather Service rejects requests without a contact string. Required, no default.
NWS_USER_AGENT="ERDC.Agents (you@example.com)"

# Where API Management sends service notifications. Required, no default.
APIM_PUBLISHER_EMAIL="you@example.com"

# Developer has no SLA and takes 30-45 minutes to provision. It is the cheapest tier that still
# supports the rate-limit-by-key policy the geo API applies; Consumption does not.
# Basicv2 and Standardv2 provision in minutes and cost more.
APIM_SKU="Developer"

# Deployment names for the two models. Changing these renames the deployments; the specialists and
# the orchestrator are pointed at them by output, so nothing else needs updating.
ORCHESTRATOR_MODEL="gpt-4.1"
SPECIALIST_MODEL="gpt-4-1-mini"

# Set only to reuse an app registration that already exists. Left unset, the preprovision hook
# creates one named geo-api-<environment name> and fills this in.
# GEO_API_AUDIENCE="api://00000000-0000-0000-0000-000000000000"
