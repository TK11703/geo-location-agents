# Configuration for the erdc-agents azd environment. No secrets: the function host key lives in an
# APIM named value, and every caller authenticates with a managed identity or a developer login.
#
# Bootstrap a new environment from this file:
#   azd env new <name> --subscription <id> --location eastus
#   Get-Content .env.example | Where-Object { $_ -match '^\w+=' } | ForEach-Object {
#       $k, $v = $_ -split '=', 2; azd env set $k $v.Trim('"') }

# Shared Foundry account and project. Pre-existing; not managed by this repo's IaC.
FOUNDRY_PROJECT_ENDPOINT="https://aaronchorpenning-0417-resource.services.ai.azure.com/api/projects/aaronchorpenning-0417"
FOUNDRY_ACCOUNT_NAME="aaronchorpenning-0417-resource"
FOUNDRY_PROJECT_NAME="aaronchorpenning-0417"
FOUNDRY_RESOURCE_GROUP="rg-AzAiServices"

# Object id of the Foundry account's system-assigned identity. The APIM policy pins the token's
# oid claim to this, so without it any principal in the tenant could call the API.
FOUNDRY_MI_PRINCIPAL_ID="267fa2b1-f580-41f1-833b-19d17a4bc86e"

# Model deployments on the shared account. Also pre-existing; resizing them affects other agents.
ORCHESTRATOR_MODEL="gpt-4.1"
SPECIALIST_MODEL="gpt-4-1-mini"

# Backend function app that serves the geo endpoints.
FUNCTION_APP_NAME="func-erdc-agents-feawr7"
FUNCTION_APP_RESOURCE_GROUP="rg-erdc-agents"

# Shared APIM instance. It hosts other APIs, so only the geo-api child is managed here.
APIM_SERVICE_NAME="Holonet-APIM-Databank-8108"
APIM_RESOURCE_GROUP="Holonet"
APIM_API_ID="geo-api"
APIM_API_PATH="geo"

# What the specialist agents actually call, and the audience they request a token for.
GEO_API_BASE_URL="https://holonet-apim-databank-8108.azure-api.net/geo"
GEO_API_AUDIENCE="api://af9bbd36-71a0-4e7e-a5af-80f8a1200f6e"
GEO_API_APP_ID="af9bbd36-71a0-4e7e-a5af-80f8a1200f6e"
