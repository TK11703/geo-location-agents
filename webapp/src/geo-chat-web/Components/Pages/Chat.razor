@page "/"
@using Microsoft.Identity.Web
@rendermode InteractiveServer
@inject OrchestratorClient Orchestrator
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler

<PageTitle>Ask the orchestrator</PageTitle>

<h1>Ask the orchestrator</h1>

<p class="text-muted">
    Name a place or give coordinates. Each question is answered on its own: the orchestrator keeps
    no conversation, so the exchanges below are a record rather than context.
</p>

<div class="chat">
    @foreach (var turn in _turns)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-light fw-semibold">@turn.Question</div>
            <div class="card-body">
                @if (turn.Answer is not null)
                {
                    <div class="answer">@turn.Answer</div>
                }
                else if (turn.Error is not null)
                {
                    <div class="alert alert-danger mb-0" role="alert">@turn.Error</div>
                }
                else
                {
                    <div class="d-flex align-items-center text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        Consulting the specialists. A cold model can take a couple of minutes.
                    </div>
                }
            </div>
        </div>
    }
</div>

<EditForm Model="_form" OnValidSubmit="AskAsync" class="mt-4">
    <DataAnnotationsValidator />

    <div class="mb-2">
        <label for="question" class="form-label">Question</label>
        <InputTextArea id="question" @bind-Value="_form.Question" class="form-control" rows="3"
                       placeholder="Conditions at 47.6062, -122.3321?" disabled="@_busy" />
        <ValidationMessage For="() => _form.Question" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_busy">
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        Ask
    </button>
</EditForm>

@code {
    private readonly List<Turn> _turns = [];
    private readonly QuestionForm _form = new();
    private bool _busy;

    private async Task AskAsync()
    {
        var question = _form.Question?.Trim();
        if (string.IsNullOrEmpty(question))
        {
            return;
        }

        var turn = new Turn(question);
        _turns.Add(turn);
        _form.Question = string.Empty;
        _busy = true;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            turn.Answer = await Orchestrator.AskAsync(question, state.User);
        }
        catch (MicrosoftIdentityWebChallengeUserException ex)
        {
            // The account has not consented to the orchestrator's scope, or the tenant wants a
            // stronger sign-in for it. Either way the fix is another trip to Entra, which the
            // handler drives.
            ConsentHandler.HandleException(ex);
        }
        catch (OrchestratorException ex)
        {
            turn.Error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class QuestionForm
    {
        [Required(ErrorMessage = "Ask something first.")]
        [StringLength(2000, ErrorMessage = "Questions are limited to 2000 characters.")]
        public string? Question { get; set; }
    }

    private sealed class Turn(string question)
    {
        public string Question { get; } = question;

        public string? Answer { get; set; }

        public string? Error { get; set; }
    }
}
